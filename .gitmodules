[submodule "src/Argon.Ion"]
	path = src/Argon.Ion
	url = https://github.com/argon-chat/Argon.Ion.git
[submodule "docs/bot-api-docs"]
	path = docs/bot-api-docs
	url = https://github.com/argon-chat/bot-api-docs.git
[submodule "src/Argon.IonAdmin"]
	path = src/Argon.IonAdmin
	url = https://github.com/argon-chat/Argon.IonAdmin.git
[submodule "docs/internal"]
	path = docs/internal
	url = https://github.com/argon-chat/server_docs.git
	# Private (Argon team only). `update = none` makes every plain `git submodule update --init`
	# and `git clone --recurse-submodules` skip it; team members opt in with
	# `git submodule update --init --checkout docs/internal`.
	update = none
