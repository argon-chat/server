<Project Sdk="Microsoft.NET.Sdk">
    <Sdk Name="ionpath.compiler" Version="2.0.1" />
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Argon</RootNamespace>
        <!-- The C# is generated at build time into obj/ from the contracts in the Argon.IonAdmin submodule. -->
        <IonProjectDirectory>..\Argon.IonAdmin</IonProjectDirectory>
    </PropertyGroup>
    <ItemGroup>
        <!-- The build type-checks against the `argon` module but only generates this project's own
             contracts; the ArgonContracts types come from here. -->
        <ProjectReference Include="..\Argon.CodeGen\Argon.Ion.CodeGen.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="ArgonContracts" />
    </ItemGroup>
</Project>