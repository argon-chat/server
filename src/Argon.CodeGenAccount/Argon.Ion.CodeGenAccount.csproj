<Project Sdk="Microsoft.NET.Sdk">
    <Sdk Name="ionpath.compiler" Version="2.0.0" />
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Argon</RootNamespace>
        <!-- The C# is generated at build time into obj/ from the contracts in Argon.IonAccount. -->
        <IonProjectDirectory>..\Argon.IonAccount</IonProjectDirectory>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="ionpath.runtime" Version="2.0.0" />
        <PackageReference Include="ionpath.runtime.client" Version="2.0.0" />
        <PackageReference Include="ionpath.runtime.network" Version="2.0.0" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    </ItemGroup>
</Project>
