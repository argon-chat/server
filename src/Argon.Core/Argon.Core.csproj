<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Library</OutputType>
        <EnablePreviewFeatures>true</EnablePreviewFeatures>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Audit.EntityFramework.Core" Version="33.0.0" />
        <PackageReference Include="Audit.NET" Version="33.0.0" />
        <PackageReference Include="Livekit.Server.Sdk.Dotnet" Version="1.2.3" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageReference Include="Hussien.SnowflakeId" Version="3.3.0" />
        <PackageReference Include="MailKit" Version="4.18.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
        <PackageReference Include="Microsoft.Orleans.BroadcastChannel" Version="10.4.0" />
        <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
        <PackageReference Include="Fido2" Version="5.0.0-preview.3" />
        <PackageReference Include="Otp.NET" Version="1.4.1" />
        <PackageReference Include="OpenIddict.Core" Version="7.7.0" />
        <PackageReference Include="OpenIddict.Server" Version="7.7.0" />
        <PackageReference Include="OpenIddict.Server.AspNetCore" Version="7.7.0" />
        <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.7.0" />
        <PackageReference Include="OpenIddict.Validation.ServerIntegration" Version="7.7.0" />
        <PackageReference Include="Ulid" Version="1.4.1" />
        <!-- Pinned like Argon.Api; do not bump. -->
        <PackageReference Include="SixLabors.ImageSharp" Version="[4.1.2]" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ArgonSharedLogicTest" />
        <InternalsVisibleTo Include="ArgonExpressionsBench" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Argon.Framework\Argon.Framework.csproj" />
        <ProjectReference Include="..\Argon.CodeGenAccount\Argon.Ion.CodeGenAccount.csproj" />
        <ProjectReference Include="..\Argon.CodeGenAdmin\Argon.Ion.CodeGenAdmin.csproj" />
        <ProjectReference Include="..\Argon.CodeGen\Argon.Ion.CodeGen.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GitVersion.MsBuild" Version="[5.12]">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Update="Resources\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Update="Migrations\Cassandra\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    </ItemGroup>

</Project>
