<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Argon.Bus</RootNamespace>
        <AssemblyName>argon-bus</AssemblyName>

        <!-- A tool, not a test project: it needs Redis and NATS to be up and it is pointed at them
             by hand. Nothing here should be collected by `dotnet test` or gated in CI. -->
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>

        <!-- The whole point is to host several SignalR servers in one process and connect real
             clients to them, so both halves of SignalR are referenced deliberately. -->
        <NoWarn>$(NoWarn);ASP0000</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
        <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
        <PackageReference Include="NATS.Net" Version="3.1.0" />
    </ItemGroup>

</Project>
